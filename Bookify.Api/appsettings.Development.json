{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Micrsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://bookifyseq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Database": "Host=bookifydb;Port=5432;Database=bookify;UserName=bookifyuser;Password=BookifyPassword123!",
    "Cache": "bookifyvalkey:6379"
  },
  "Authentication": {
    "Audience": "account",
    "ValidIssuer": "http://bookifyidp:8080/realms/bookify",
    "MetadataUrl": "http://bookifyidp:8080/realms/bookify/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "BaseUrl": "http://bookifyidp:8080",
    "AdminUrl": "http://bookifyidp:8080/admin/realms/bookify/",
    "TokenUrl": "http://bookifyidp:8080/realms/bookify/protocol/openid-connect/token",
    "AdminClientId": "bookify-admin-client",
    "AdminClientSecret": "UZDmbNxWmV4TlpaCRcju6pMRsyuV3er1",
    "AuthClientId": "bookify-auth-client",
    "AuthClientSecret": "3E3yvXaYppoYBF3Ir6DgtEzADKKzSurZ"
  }
}